{
  "name": "miku-event-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:diff": "tsx scripts/schema-diff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@libsql/client": "0.18.0",
    "@the-convocation/twitter-scraper": "0.22.3",
    "cheerio": "1.2.0",
    "discord.js": "14.28.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "fast-xml-parser": "5.12.1",
    "node-cron": "4.6.0",
    "playwright": "1.65.1",
    "rss-parser": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
