# 값을 채워 .env로 복사한다. .env는 커밋하지 않는다.
# 주석은 따로 한 줄로 쓴다. 값 뒤에 붙인 주석은 값으로 읽힐 수 있다.

# ── 필수 (1단계) ──
# Railway: file:/data/tracker.db / 로컬: file:./data/tracker.db
DATABASE_URL=
# UTC 고정
TZ=UTC
# 관리 화면 Basic Auth, user:password 형식
ADMIN_BASIC_AUTH=

# ── 서버 ──
# 기본 3000. Railway는 자동으로 넣어 준다
PORT=

# ── DB (Turso로 옮길 때만) ──
TURSO_AUTH_TOKEN=

# ── Claude API (Max 크레딧이 연결된 Console 조직에서 발급) ──
ANTHROPIC_API_KEY=

# ── 디스코드 봇 ──
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_NOTICE_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=
# 선택: 공지 채널 웹후크 URL. 아는 사람은 누구나 채널에 글을 올릴 수 있으므로 커밋 금지
DISCORD_NOTICE_WEBHOOK_URL=

# ── 수집 ──
KOPIS_SERVICE_KEY=
# NAVER API HUB: Client ID → 헤더 X-NCP-APIGW-API-KEY-ID, Client Secret → 헤더 X-NCP-APIGW-API-KEY
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# X 보조 계정 쿠키 (메인 계정 금지)
X_AUTH_TOKEN=
X_CT0=
# 내 인스타그램 프로페셔널 계정
IG_USER_ID=
IG_ACCESS_TOKEN=
